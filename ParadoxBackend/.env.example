PORT=
AUTH_MODE=
# [hardening 2026-07-14] Second, explicit opt-in required (in addition to AUTH_MODE=NONE and
# NODE_ENV!=production) before the EOS login route will auto-create/log in as an arbitrary
# account with no real authentication. Must be the literal string "true" - never set this in any
# real deployment. See routes/eos.ts.
ALLOW_NO_AUTH_DEV_MODE=
AUTH_SIGNING_PRIVKEY_B64=
AUTH_SIGNING_PUBKEY_B64=
MONGODB_URI=
MONGODB_DB=
MONGODB_APP_NAME=
MONGODB_CONNECT_TIMEOUT_MS=
MONGODB_SERVER_SELECTION_TIMEOUT_MS=
MONGODB_MAX_POOL_SIZE=
MONGODB_MAX_IDLE_TIME_MS=

# --- Bootstrap regression tests (scripts/test_bootstrap_regression.cjs / npm run test:bootstrap) ---
# These are DESTRUCTIVE integration tests. They refuse to run unless BOTH of the following are set,
# and MONGODB_TEST_DB must be a dedicated database name DIFFERENT from MONGODB_DB. The suite
# redirects the app's own Mongo client onto MONGODB_TEST_DB so it never touches the main database.
# Leave both blank/absent in any real deployment.
ALLOW_DB_INTEGRATION_TESTS=
MONGODB_TEST_DB=

TARGET_CHANGELIST=
QOS_TARGET_URL=
MATCHMAKING_MODE=
DEPLOYSERVER_URL=

# --- HTTPS / TLS (game client) ---
# With the in-process DLL redirect the game connects to https://paradox.example.com and
# Metagame terminates TLS directly (no nginx). Defaults point at the public Let's Encrypt
# fullchain in ../ParadoxCertificates; override only to relocate them. In production set
# HTTPS_PORT=443 (rewritten URLs carry no port).
HTTPS_PORT=
PARADOX_CERT_PEM_PATH=
PARADOX_KEY_PEM_PATH=
# REQUIRED to serve the paradox cert: the shipped key is AES-256-CBC encrypted. Set this to
# its passphrase (kept out of git). If unset/wrong, the paradox HTTPS identity fails to load
# and the HTTPS listener cannot start.
PARADOX_KEY_PASSPHRASE=

# --- Launcher auth (Plans/LAUNCHER_BACKEND_AUTH_REQUIREMENTS.md) ---
# Reuses AUTH_SIGNING_PRIVKEY_B64/AUTH_SIGNING_PUBKEY_B64 above (a different JWT
# audience, not a different keypair). Everything below is optional except when
# noted — the email/password launcher flow works with none of these set.
#
# Required only for Discord sign-in; register an app at
# https://discord.com/developers/applications and add DISCORD_REDIRECT_URI
# there as an OAuth2 redirect. /launcher/v1/auth/discord/start returns a clear
# AUTH_DISCORD_NOT_CONFIGURED error until these are set — everything else in
# the launcher API works without them.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
# Custom URL scheme the Tauri launcher registers (matches Launcher/src-tauri/tauri.conf.json).
LAUNCHER_DEEPLINK_SCHEME=mysticparadox
# CORS allow-list for the browser/webview calling /launcher/v1/*. The Vite dev
# origin (http://localhost:1420) is always allowed; add the packaged Tauri
# app's real production origin here (comma-separated if more than one) once
# it's confirmed against a built app — see the requirements doc's status notes.
LAUNCHER_ALLOWED_ORIGINS=
# REQUIRED for POST /launcher/v1/game-sessions to ever issue a code — comma-separated
# lowercase SHA-256 hex hashes of the approved Dauntless-Win64-Shipping.exe build(s).
# Fails closed: unset/empty rejects every game-session request rather than trusting
# any hash a client claims. Get the real hash by running the verification hash the
# Rust launcher computes against your own approved build, or `certutil -hashfile
# Dauntless-Win64-Shipping.exe SHA256` on Windows.
APPROVED_EXECUTABLE_SHA256=

# --- Closed-test player manager ---
# Exact browser origins allowed to call /admin/v1 (comma-separated). Prefer the
# same-origin nginx layout from admin.paradox.example.com.conf.example.
ADMIN_ALLOWED_ORIGINS=https://admin.paradox.example.com
# Base32 TOTP secret stored out-of-band. Production admin login fails closed
# while this is blank. All bootstrap admins currently share this operator MFA
# secret; rotate it whenever administrator membership changes.
ADMIN_TOTP_SECRET=
# Local HTTP testing may leave this blank. Production sets Secure automatically
# when NODE_ENV=production; "true" forces Secure in another environment.
ADMIN_COOKIE_SECURE=

# --- Signed launcher/runtime update distribution ---
# Directory containing launcher and runtime artifacts/manifests.
LAUNCHER_UPDATE_ROOT=
# Long random secret used only by the separate Mystic Update Publisher app.
# Never embed this value in the public game launcher.
UPDATE_PUBLISHER_API_KEY=
UPDATE_PUBLIC_BASE_URL=https://paradox.example.com
# Comma-separated source IPs allowed to PUSH updates (admin upload route only).
# Empty/blank denies every push (fail-closed). Defaults to the operator's box.
UPDATE_PUBLISHER_ALLOWED_IPS=203.0.113.10

# --- Realtime XMPP presence/chat (Plans/XMPP_PRESENCE_CHAT_IMPLEMENTATION_PLAN.md) ---
# Master gate for the owned XMPP WebSocket endpoint on the HTTPS listener
# (path /__ws/xmpp). Must be the literal "true" to enable; anything else rejects
# every WS upgrade cleanly and keeps ordinary HTTPS/REST unaffected (plan §21).
REALTIME_XMPP_ENABLED=
# Sanitized protocol capture logging. Defaults ON while REALTIME_XMPP_ENABLED=true
# (this is the capture milestone). Set to "false" to silence once fixtures exist.
# Never logs credentials, SASL payloads, tokens, or message bodies (plan §7).
REALTIME_XMPP_CAPTURE=
# Optional comma-separated override of accepted WS upgrade paths (default: "//,/,/__ws/xmpp").
# The 1.12 client requests "//" (host-only ServerAddr + ":port"). Explicit allowlist, no fallback.
REALTIME_XMPP_WS_PATHS=
# Optional comma-separated Host allow-list for the WS upgrade (lowercased, no port).
# Empty = allow any Host (dev capture). Set to paradox.example.com to lock down.
REALTIME_XMPP_ALLOWED_HOSTS=
# DEV-ONLY + INSECURE: allow any authenticated user to join any City-<uuid> MUC room. There is no
# authoritative accountId->Ramsgate-instance mapping yet, so City-room membership cannot be
# verified. Defaults ON during development; set to "false" to disable City chat until the mapping
# exists. Party MUC is always authorized by real party membership regardless of this flag.
REALTIME_XMPP_DEV_CITY_MUC=

# --- Inventory / store / economy diagnostic capture (src/diagnostics/capture.ts) ---
# Structured, low-noise, greppable [INV-CAP] tracing of POST /inventory transactions and
# single-item saves (POST /inventory/instanceditem). OFF by default; safe to leave enabled
# during inv/store iteration. All flags accept 1/true/on/yes.
#   MYSTICPARADOX_INV_CAPTURE         enable [INV-CAP] structured capture (request/result/error + ITEM-UPDATE)
#   MYSTICPARADOX_INV_CAPTURE_RAW     additionally dump the full JSON of each captured payload/result
#   MYSTICPARADOX_INV_CAPTURE_FILTER  optional case-insensitive regex of catalogIds to focus on; a
#                               transaction touching no matching catalogId is skipped, e.g.
#                               "CONTAINER_CORE|CELLCORE" (core dupe) or "CELL_" (cell equips)
MYSTICPARADOX_INV_CAPTURE=
MYSTICPARADOX_INV_CAPTURE_RAW=
MYSTICPARADOX_INV_CAPTURE_FILTER=
# Legacy raw body dump in app.ts (broad path match: progression/store/currency/inventory/...).
# Prefer MYSTICPARADOX_INV_CAPTURE above for inventory work; kept for other economy paths.
MYSTICPARADOX_BODY_CAPTURE=

# Shared post-ready hunt release window. Existing CR19 queue timing remains unchanged.
HUNT_GO_NOW_MIN_DELAY_MS=10000
HUNT_GO_NOW_MAX_DELAY_MS=20000
