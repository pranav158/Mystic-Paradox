PORT=
AUTH_MODE=
# [hardening 2026-07-14] Second, explicit opt-in required (in addition to AUTH_MODE=NONE and
# NODE_ENV!=production) before the EOS login route will auto-create/log in as an arbitrary
# account with no real authentication. Must be the literal string "true" - never set this in any
# real deployment. See routes/eos.ts.
ALLOW_NO_AUTH_DEV_MODE=
AUTH_SIGNING_PRIVKEY_B64=
AUTH_SIGNING_PUBKEY_B64=
# Long random secret (32+ characters) under which gameserver and user API keys are HMAC-hashed before
# MongoDB storage. Required: the API refuses to start without it. Keep it stable - rotating it invalidates every
# stored HMAC hash until the keys are registered again. Key records written before HMAC hashing (plain SHA-256)
# no longer match; register those keys again, for example through GAMESERVER_API_KEYS.
# [2026-10-14] It also keys the pseudonyms that replace an erased account's id (security/apiKeyHash.ts PseudonymousAccountId) and the
# deletion tombstones; rotating it makes those pseudonyms, and so the tombstones' links to them, stop matching.
API_KEY_HASH_SECRET=
# Comma-separated raw keys accepted from dedicated gameservers; set the Director's METAGAME_API_KEY to one
# of them. When non-empty this is the complete key set: keys are HMAC-hashed into MongoDB and a key removed
# here is revoked at the next restart (legacy SHA-256 records are deleted too). Unset or empty keeps the keys
# already stored.
GAMESERVER_API_KEYS=
# Per-address request budget per minute for every route (security/rateLimit.ts). Gameserver-keyed calls have their
# own budget because every hub and hunt on one host shares its address. Blank keeps the defaults (600 / 6000);
# MYSTICPARADOX_RATE_LIMIT=off disables the budget. The stricter per-route limits (login, uploads) always apply.
MYSTICPARADOX_RATE_LIMIT=
MYSTICPARADOX_RATE_LIMIT_PER_MINUTE=
MYSTICPARADOX_GAMESERVER_RATE_LIMIT_PER_MINUTE=
# Budget per minute of each validated player-host credential (optional P2P module; blank keeps 6000).
MYSTICPARADOX_HOST_RATE_LIMIT_PER_MINUTE=
# Observe-only census of the backend routes a player-host runtime calls: one "[HostRoute] summary" line per minute with
# traffic, nothing is blocked. Blank or on keeps it; off (or 0/false/no) unmounts it.
MYSTICPARADOX_HOST_ROUTE_CENSUS=
# Per-account bounty state (season-challenge progress and claims) and cooldowns (daily bounty draft, patrol bonus)
# are stored in MongoDB. Blank keeps them on; off (or 0/false/no) restores the old stubs that discard every save,
# so each arrival re-seeds the challenges and pays once-per-period rewards again.
MYSTICPARADOX_BOUNTY_PERSISTENCE=
MYSTICPARADOX_COOLDOWN_PERSISTENCE=
# [PrestigeMon]/[DraftMon] economy log lines for the few currencies and draft tokens they watch; off silences them.
# Also silences the ledger monitors below (log only, nothing is ever refused by them).
MYSTICPARADOX_ECONOMY_MONITOR=
# [PlatMon]/[HuntPassMon] economy ledger (diagnostics/economyLedgerMonitor.ts): every Platinum credit and spend, and every
# Hunt Pass reward, per source, with a per-account per-UTC-day rollup (collection economyDaily, about 400 days). A FLAG line
# is written when an account's day total first crosses a threshold. Read once at startup; the defaults are shown.
MYSTICPARADOX_PLAT_DAILY_FLAG=5000
MYSTICPARADOX_PLAT_DAILY_SPEND_FLAG=5000
MYSTICPARADOX_SEASONAL_COIN_DAILY_FLAG=1000
# [XpMon] per-hunt XP (p2p/observability/huntXpMonitor.ts): weapon + player XP per minute of one hunt member before a FLAG.
# Per-hunt XP has no limit (owner decision); the default is about ten times a normal pace of one kill a minute.
MYSTICPARADOX_XP_PER_MINUTE_FLAG=2000
MONGODB_URI=
MONGODB_DB=
MONGODB_APP_NAME=
# Application bounds: connect/server-selection 250-30000 ms (default 5000), pool 1-500
# connections (default 20), idle 0-300000 ms (default 60000; 0 means no idle limit).
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=20
MONGODB_MAX_IDLE_TIME_MS=60000
# Blank/unset keeps the local combined process. Production must set it explicitly (api).
MYSTICPARADOX_SERVICE_ROLE=
# Application bound: 250-30000 ms; production rejects malformed, infinite or oversized values.
MONGODB_TRANSACTION_MAX_COMMIT_TIME_MS=2000

# --- Bootstrap regression tests (scripts/test_bootstrap_regression.cjs / npm run test:bootstrap) ---
# These are DESTRUCTIVE integration tests. They refuse to run unless BOTH of the following are set,
# and MONGODB_TEST_DB must be a dedicated database name DIFFERENT from MONGODB_DB. The suite
# redirects the app's own Mongo client onto MONGODB_TEST_DB so it never touches the main database.
# Leave both blank/absent in any real deployment.
ALLOW_DB_INTEGRATION_TESTS=
MONGODB_TEST_DB=

TARGET_CHANGELIST=
QOS_TARGET_URL=
MATCHMAKING_MODE=
DEPLOYSERVER_URL=
# [2026-10-15] Unset or blank DEPLOYSERVER_URL means no DeployServer (the VPS): no dedicated hub or hunt is requested, and every hunt is
# player-hosted (realms). Official play (a launch with no realm) then defaults to off.
# MYSTICPARADOX_OFFICIAL_PLAY=on|off: on or off. Unset = on when DEPLOYSERVER_URL is set, otherwise off. Off refuses official launches
# with OFFICIAL_PLAY_UNAVAILABLE and tells the launcher the official server is unavailable; realm play is not affected. Any other value
# is off, with a warning.
# MYSTICPARADOX_OFFICIAL_PLAY=off

# Private Prometheus-style metrics endpoint token. Production API startup fails closed when it
# is empty; never expose this value to the launcher or dashboard bundle.
MYSTICPARADOX_METRICS_TOKEN=

# --- HTTPS / TLS (game client) ---
# With the in-process DLL redirect the game connects to https://paradox.example.com and
# Metagame terminates TLS directly (no nginx). Defaults point at the public Let's Encrypt
# fullchain in ../ParadoxCertificates; override only to relocate them. In production set
# HTTPS_PORT=443 (rewritten URLs carry no port).
HTTPS_PORT=
PARADOX_CERT_PEM_PATH=
PARADOX_KEY_PEM_PATH=
# REQUIRED to serve the paradox cert: the shipped key is AES-256-CBC encrypted. Set this to
# its passphrase (kept out of git). If unset/wrong, the paradox HTTPS identity fails to load
# and the HTTPS listener cannot start.
PARADOX_KEY_PASSPHRASE=

# --- Behind a reverse proxy (an nginx example: docs/SELF_HOSTING.md) [2026-10-14 M2] ---
# on: nginx terminates TLS on 443 and forwards to PORT on loopback. No HTTPS listener and no certificate
# are needed (production included); the XMPP WebSocket gateway attaches to the plain listener. Default off.
# With it on, also set BIND_HOST=127.0.0.1, QOS_PORT=off (nginx answers the region ping) and
# REALTIME_XMPP_ALLOWED_HOSTS=paradox.mysticfox.dev. Any other value stops startup.
# MYSTICPARADOX_TLS_TERMINATED_BY_PROXY=on
# Address the plain HTTP listener binds to. Unset = every interface (as before). Use 127.0.0.1 behind a proxy.
# BIND_HOST=127.0.0.1
# Region-ping listener (plain HTTP, answers "pong"). Unset = port 80; off = none; or a port number.
# QOS_PORT=off

# --- Hunt manifests for player-hosted (P2P and realm) hunts [2026-10-14 M1] ---
# local (default): the Metagame resolves the launch manifest from the hunt tables; no DeployServer is needed.
# director: ask DeployServer (DEPLOYSERVER_URL) as before, for comparison.
# MYSTICPARADOX_HUNT_MANIFEST_SOURCE=local
# Folder with player_hunts_table.json and the matchmaker tables. Unset = ParadoxDirector/game-data in this checkout.
# PARADOX_HUNT_DATA_DIR=
# Trials rotation bucket in minutes (the same value DeployServer and the game server read). Unset = 10080 (one week).
# TRIALS_ROTATION_MINUTES=10080

# --- Launcher auth (Plans/LAUNCHER_BACKEND_AUTH_REQUIREMENTS.md) ---
# Reuses AUTH_SIGNING_PRIVKEY_B64/AUTH_SIGNING_PUBKEY_B64 above (a different JWT
# audience, not a different keypair). Everything below is optional except when
# noted — the email/password launcher flow works with none of these set.
#
# Required only for Discord sign-in; register an app at
# https://discord.com/developers/applications and add DISCORD_REDIRECT_URI
# there as an OAuth2 redirect. /launcher/v1/auth/discord/start returns a clear
# AUTH_DISCORD_NOT_CONFIGURED error until these are set — everything else in
# the launcher API works without them.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
# Custom URL scheme the Tauri launcher registers (matches Launcher/src-tauri/tauri.conf.json).
LAUNCHER_DEEPLINK_SCHEME=mysticparadox
# CORS allow-list for the browser/webview calling /launcher/v1/*. The Vite dev
# origin (http://localhost:1420) is always allowed; add the packaged Tauri
# app's real production origin here (comma-separated if more than one) once
# it's confirmed against a built app — see the requirements doc's status notes.
LAUNCHER_ALLOWED_ORIGINS=
# REQUIRED for POST /launcher/v1/game-sessions to ever issue a code — comma-separated
# lowercase SHA-256 hex hashes of the approved Dauntless-Win64-Shipping.exe build(s).
# Fails closed: unset/empty rejects every game-session request rather than trusting
# any hash a client claims. Get the real hash by running the verification hash the
# Rust launcher computes against your own approved build, or `certutil -hashfile
# Dauntless-Win64-Shipping.exe SHA256` on Windows.
APPROVED_EXECUTABLE_SHA256=

# [2026-10-14] What a newly registered launcher account starts with, on every provider (launcher and Discord sign-up):
# required = the account waits as pending until an operator approves it (the official server: set this on production);
# off = approved at once. Blank means off (the default, so a local server or a closed-test build works without an operator).
# Any other value is read as required with a startup warning. The old MYSTICPARADOX_REGISTRATION_AUTO_APPROVE switch is
# replaced: setting it only logs a startup warning and has no effect.
MYSTICPARADOX_REGISTRATION_APPROVAL=

# [2026-10-16] Extra terms a new username may not contain, on top of the built-in staff/impersonation and offensive lists
# (src/security/usernamePolicy.ts): comma or space separated, letters and digits, 2-32 characters each, matched in any letter case
# and in digit spellings (0=o, 1=i/l, 3=e, ...). Names already taken are not checked again. Blank = the built-in lists only.
MYSTICPARADOX_USERNAME_BLOCKLIST=

# [2026-10-14] Launcher Guard verdicts. observe (blank = observe): no verdict refuses hosting, host selection, hub start, admission or
# play; each refusal the enforce rule would make is logged once per Guard session as "[GuardObserve] would refuse ...". enforce: the
# refusals as before, governed by the operations policy (GUARD_ENFORCEMENT, ENFORCE by default) and P2P_LAUNCHER_GUARD_REQUIRED=true.
# Any other value is enforce, with a startup warning. Guard module findings and the session history are recorded in both modes.
MYSTICPARADOX_GUARD_MODE=

# [2026-10-16] Unofficial launcher builds, apart from MYSTICPARADOX_GUARD_MODE (security/unofficialLauncherPolicy.ts). At Play the launcher
# reports its version and launcher.exe SHA-256; a hash other than the one the Guard manifest pins, on the served launcher version or newer,
# is "unofficial" (self-built or repackaged). observe (blank, default, or any unknown value): nothing is refused, the UNOFFICIAL_LAUNCHER
# activity flag is raised. refuse: Play is refused with LAUNCHER_UNOFFICIAL (403); an older official version (it updates itself) and
# a launcher that sends no report (before 0.1.65) still play. The report is the launcher's own word: a fence, not a lock.
MYSTICPARADOX_UNOFFICIAL_LAUNCHER=
# Extra launcher.exe SHA-256 hashes treated as official (local test builds), comma or space separated.
MYSTICPARADOX_LAUNCHER_ALLOWED_HASHES=
# Accounts with the admin role are exempt from refuse unless this is off (the tester role no longer is, 16 Oct).
MYSTICPARADOX_UNOFFICIAL_LAUNCHER_TESTERS_EXEMPT=

# [2026-10-14] Terms of Use and Privacy Policy consent (the versions and minimum age are in src/legal/legalPolicy.ts; they must match
# ParadoxLauncher/src/legal/legalMeta.ts). CONSENT_REQUIRED: on when blank. Registration must then carry the current consent
# ({termsVersion, privacyVersion, ageConfirmed: true}); without it the answer is 400 CONSENT_REQUIRED. An explicit value wins. When
# blank the default follows PERSISTENCE_PROVIDER: on with mongodb (the official backend), off with sqlite (a local server, whose operator
# sets its own rules). CONSENT_ENFORCE: off when blank. on refuses game sessions and realm hosting for an account without the current
# consent (403 CONSENT_REQUIRED) until it accepts in the launcher (POST /launcher/v1/account/consent).
MYSTICPARADOX_CONSENT_REQUIRED=
MYSTICPARADOX_CONSENT_ENFORCE=

# [2026-10-15] Email verification by a one-time code (controllers/launcherEmail.ts; the mail itself is src/mail/codeEmail.ts). off (the
# default, and blank) signs in without checking the email. required: a new registration is mailed a 6-digit code and waits for it, and an
# account whose email is not verified (accounts from before the switch included) gets a code at sign-in and must enter it. A code is valid
# 5 minutes, works once, and stops after 5 wrong tries. Switch it on only after launcher 0.1.67 is out: older launchers cannot enter a code.
# An unrecognised value is read as required, with a startup warning. required without working SMTP settings (host, user and password)
# stops the backend at startup, as a missing API_KEY_HASH_SECRET does.
MYSTICPARADOX_EMAIL_VERIFICATION=
# [2026-10-15] The SMTP server that sends the codes (the owner uses Mailgun). Host, user and password are required for required. The
# password is write-only in the manager and is never printed or logged. Port: blank means 587 (with STARTTLS); 465 goes with SMTP_SECURE=tls.
MYSTICPARADOX_SMTP_HOST=
MYSTICPARADOX_SMTP_PORT=
# starttls (blank, the default: a plain connection upgraded to TLS, which is required) or tls (TLS from the first byte, for port 465).
# Any other value counts as not set up, so the code mail is refused.
MYSTICPARADOX_SMTP_SECURE=
MYSTICPARADOX_SMTP_USER=
MYSTICPARADOX_SMTP_PASSWORD=
# The From header of the code mail. Blank means Mystic Paradox <no-reply@mysticfox.dev>.
MYSTICPARADOX_MAIL_FROM=

# [2026-10-14] Server log retention (Privacy Policy section 5). At each server start the previous debug/metagame/metagame.log is archived
# as metagame-<UTC date and time>.log when it is from an earlier UTC day or over 100 MB, and archives older than this many days are
# deleted. Blank or not a whole number of at least 1: 90.
MYSTICPARADOX_LOG_RETENTION_DAYS=

# [2026-10-15] Uploaded launcher logs (tester uploads) are removed 90 days after their last upload (UPLOADED_LAUNCHER_LOG_RETENTION_DAYS in
# src/legal/retentionPolicy.ts). The server runs that pass about a minute after start and then every 6 hours, and logs one line per pass
# with counts only. MYSTICPARADOX_LOG_RETENTION=off turns the automatic pass off (scripts/purge_uploaded_logs.ts still works by hand).
# Blank or on: on.
MYSTICPARADOX_LOG_RETENTION=

# [2026-10-14] Gauntlet hunts are refused on every route (realm, player-hosted and dedicated) with the cancel reason
# GAUNTLET_DISABLED until this is "on". Gauntlet is not enabled or tested yet. Any other value, or unset, keeps it refused.
# The Gauntlet leaderboard and information routes are not affected.
# [2026-10-16] While it is not "on", the game's hunt map also shows Gauntlet disabled: every Slayer's Path answer (/pjm) serves the node
# Gauntlet_Unlock as Locked. The stored map keeps each player's real unlock, so turning this on shows it again.
MYSTICPARADOX_GAUNTLET=off

# --- Closed-test player manager ---
# Exact browser origins allowed to call /admin/v1 (comma-separated). Production
# fails closed when this is unset. This must include the real dashboard origin.
ADMIN_ALLOWED_ORIGINS=https://admin.paradox.example.com
# Base32 TOTP secret stored out-of-band. Production email/password admin login
# fails closed while this is blank. The allow-listed Discord OAuth flow is the
# separate MFA path and intentionally does not request this TOTP code.
ADMIN_TOTP_SECRET=
# Optional separate TOTP secret for Guard downgrades and development diagnostics.
# If empty, ADMIN_TOTP_SECRET is used. Never expose either secret to the UI.
ADMIN_OPERATIONS_TOTP_SECRET=
# Local HTTP testing may leave this blank. Production sets Secure automatically
# when NODE_ENV=production; "true" forces Secure in another environment.
ADMIN_COOKIE_SECURE=

# --- Admin dashboard: "Sign in with Discord" (controllers/adminDiscordAuth.ts) ---
# Reuses the same Discord app as the launcher (DISCORD_CLIENT_ID/SECRET above) but
# needs its OWN redirect URI registered in the Discord developer portal, since this
# flow completes with an ordinary 302 back to the dashboard rather than a deep link.
# GET /admin/v1/auth/discord/start returns 503 until the client credentials,
# redirect URI, frontend URL, and explicit allow-list are all configured safely.
ADMIN_DISCORD_REDIRECT_URI=https://admin.paradox.example.com/admin/v1/auth/discord/callback
# Where the browser lands after the OAuth round-trip completes (session cookie is
# set for this response). Should match the dashboard's real origin / one of the
# ADMIN_ALLOWED_ORIGINS entries above.
ADMIN_FRONTEND_URL=https://admin.paradox.example.com/
# Comma-separated Discord user IDs (snowflakes) allowed to authenticate as an
# administrator via this flow — fails closed for anyone else regardless of any
# account/role a Discord identity is linked to. Required: there is no source-code
# fallback, so copied deployments cannot silently trust the original operator.
ADMIN_DISCORD_ALLOWED_IDS=

# --- Admin API [2026-10-15] ---
# on: serve /admin (players, bans, approvals, activity, Guard findings, P2P operations, launcher logs, the tester tool) and the
# manager preflight GET /health/release-gates, each behind its own admin or loopback check. off: /admin answers 404 and the
# preflight is not mounted. Blank (default): on only when MYSTICPARADOX_MANAGER_ADMIN=on, so a self-hosted backend starts with no
# admin surface. Set on to use the admin API with the backend's own admin sign-in (ADMIN_* keys above). Any other value stops startup.
MYSTICPARADOX_ADMIN_API=

# --- Manager operator credential [2026-10-14, P5.1] ---
# src/security/managerOperator.ts holds the full contract (canonical string, headers, loopback only, no forwarding header,
# 60 s window, 120 s replay cache). off or blank = the cookie session only (default). on = /admin/v1 also accepts the manager's
# signed X-Paradox-Operator-* headers from loopback, as actor manager:<operatorId> in every audit record. Any other value stops
# startup. The secret is required while on (32+ characters, the value the manager holds); it is never logged or sent to a browser.
MYSTICPARADOX_MANAGER_ADMIN=off
MYSTICPARADOX_MANAGER_OPERATOR_SECRET=

# --- Signed launcher/runtime update distribution ---
# Directory containing launcher and runtime artifacts/manifests.
LAUNCHER_UPDATE_ROOT=
# Long random secret used only by the separate Mystic Update Publisher app.
# Never embed this value in the public game launcher.
UPDATE_PUBLISHER_API_KEY=
UPDATE_PUBLIC_BASE_URL=https://paradox.example.com
# Where launcher self-update manifests (LAUNCHER_UPDATE_ROOT/launcher/windows/x86_64/latest.json) may send launchers
# besides this backend: comma-separated https prefixes ending in "/". Unset: the official GitHub releases
# (https://github.com/pranav158/Mystic-Paradox/releases/download/). A manifest pointing anywhere else is not offered.
# LAUNCHER_UPDATE_URL_PREFIXES=
# Comma-separated source IPs allowed to PUSH updates (admin upload route only).
# Unset or empty denies every push (fail-closed); set your publishing machine's address.
UPDATE_PUBLISHER_ALLOWED_IPS=
# Comma-separated extra runtime file names the publisher accepts besides winmm.dll (an optional module's
# runtime files). Every file still needs a valid runtime signature. Empty: winmm.dll only.
RUNTIME_EXTRA_FILES=

# --- Realtime XMPP presence/chat (Plans/XMPP_PRESENCE_CHAT_IMPLEMENTATION_PLAN.md) ---
# Master gate for the owned XMPP WebSocket endpoint on the HTTPS listener
# (path /__ws/xmpp). Must be the literal "true" to enable; anything else rejects
# every WS upgrade cleanly and keeps ordinary HTTPS/REST unaffected (plan §21).
REALTIME_XMPP_ENABLED=
# Sanitized protocol capture logging. Defaults ON while REALTIME_XMPP_ENABLED=true
# (this is the capture milestone). Set to "false" to silence once fixtures exist.
# Never logs credentials, SASL payloads, tokens, or message bodies (plan §7).
REALTIME_XMPP_CAPTURE=
# Optional comma-separated override of accepted WS upgrade paths (default: "//,/,/__ws/xmpp").
# The 1.12 client requests "//" (host-only ServerAddr + ":port"). Explicit allowlist, no fallback.
REALTIME_XMPP_WS_PATHS=
# Optional comma-separated Host allow-list for the WS upgrade (lowercased, no port).
# Empty = allow any Host (dev capture). Set to paradox.example.com to lock down.
REALTIME_XMPP_ALLOWED_HOSTS=
# DEV-ONLY + INSECURE: allow any authenticated user to join any City-<uuid> MUC room. There is no
# authoritative accountId->Ramsgate-instance mapping yet, so City-room membership cannot be
# verified. Defaults ON during development; set to "false" to disable City chat until the mapping
# exists. Party MUC is always authorized by real party membership regardless of this flag.
REALTIME_XMPP_DEV_CITY_MUC=false

# --- Inventory / store / economy diagnostic capture (src/diagnostics/capture.ts) ---
# Structured, low-noise, greppable [INV-CAP] tracing of POST /inventory transactions and
# single-item saves (POST /inventory/instanceditem). OFF by default; safe to leave enabled
# during inv/store iteration. All flags accept 1/true/on/yes.
#   MYSTICPARADOX_INV_CAPTURE         enable [INV-CAP] structured capture (request/result/error + ITEM-UPDATE)
#   MYSTICPARADOX_INV_CAPTURE_RAW     additionally dump the full JSON of each captured payload/result
#   MYSTICPARADOX_INV_CAPTURE_FILTER  optional case-insensitive regex of catalogIds to focus on; a
#                               transaction touching no matching catalogId is skipped, e.g.
#                               "CONTAINER_CORE|CELLCORE" (core dupe) or "CELL_" (cell equips)
MYSTICPARADOX_INV_CAPTURE=
MYSTICPARADOX_INV_CAPTURE_RAW=
MYSTICPARADOX_INV_CAPTURE_FILTER=
# Legacy raw body dump in app.ts (broad path match: progression/store/currency/inventory/...).
# Prefer MYSTICPARADOX_INV_CAPTURE above for inventory work; kept for other economy paths.
MYSTICPARADOX_BODY_CAPTURE=

# Central operations policy switches between the production and development profiles. Production
# accepts only info/warn/error/fatal here; debug/trace are clamped to info. Development defaults to
# debug and may explicitly use trace.
LOG_LEVEL=info
MYSTICPARADOX_DEVELOPMENT_LOG_LEVEL=debug

# Shared post-ready hunt release window. Existing CR19 queue timing remains unchanged.
HUNT_GO_NOW_MIN_DELAY_MS=10000
HUNT_GO_NOW_MAX_DELAY_MS=20000
