{
  "name": "paradox-backend",
  "version": "0.0.3",
  "description": "Mystic Paradox backend - a private server for the defunct monster-hunting action RPG",
  "license": "AGPL-3.0-only",
  "author": "Mystic Paradox (pranav158)",
  "contributors": [
    "gwog :3 (original Undaunted author)"
  ],
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "start": "node --env-file=.env dist/server.js",
    "generate:progression-config": "node scripts/generate_progression_config.cjs",
    "generate:slayers-path": "node scripts/generate_slayers_path.cjs",
    "generate:ladyluck-store": "node scripts/generate_ladyluck_store.cjs",
    "test:bootstrap": "npm run build && node --env-file=.env scripts/test_bootstrap_regression.cjs",
    "test:loadout": "node --import tsx --test src/loadoutSlots.test.ts",
    "test:realtime": "node --import tsx --test src/realtime/jid.test.ts src/realtime/stateMachine.test.ts src/realtime/xml.test.ts src/realtime/XMPPAuth.test.ts src/realtime/DirectChatService.test.ts src/realtime/RoomService.test.ts src/realtime/PresenceService.test.ts src/realtime/SessionRegistry.test.ts",
    "test:auth-security": "node --import tsx --test src/security/accountEligibility.test.ts src/security/totp.test.ts",
    "admin:bootstrap": "tsx --env-file=.env scripts/bootstrap_admin.ts",
    "approval:migrate": "tsx --env-file=.env scripts/migrate_launcher_approval.ts",
    "test:matchmaking": "node --import tsx --test src/matchmakingParty.test.ts src/apiKeysConfig.test.ts",
    "test": "npm run test:loadout && npm run test:realtime && npm run test:auth-security && npm run test:matchmaking"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "dotenv": "^17.4.2",
    "express": "5.2.1",
    "jsonwebtoken": "^9.0.3",
    "ltx": "3.1.2",
    "mongodb": "7.5.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "26.0.0",
    "@types/ws": "8.18.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}
