{
  "name": "paradox-backend",
  "version": "0.0.3",
  "description": "Mystic Paradox - a private server for the defunct monster-hunting action RPG",
  "license": "AGPL-3.0-only",
  "author": "Mystic Paradox (pranav158)",
  "contributors": [
    "gwog :3 (original Undaunted author)"
  ],
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "clean": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "prestart": "node scripts/ensure-build-fresh.cjs",
    "start": "node --env-file=.env build/server.js",
    "prestart:api": "node scripts/ensure-build-fresh.cjs",
    "start:api": "node --env-file=.env build/server.js",
    "test:bootstrap": "npm run build && node --env-file=.env scripts/test_bootstrap_regression.cjs",
    "test:p2p-distributed-mongo": "node --import tsx --test src/p2p/security/guardTrafficDistributed.integration.test.ts",
    "pretest:mongo-migration-rehearsal": "node --test scripts/test_mongo_schema_migration_rehearsal.test.cjs",
    "test:mongo-migration-rehearsal": "node scripts/test_mongo_schema_migration_rehearsal.cjs",
    "test:p2p-auto-pause": "node scripts/p2p/test_reward_invariant_pause.cjs",
    "test:p2p-field-evidence": "node --test ../scripts/validate-central-guard-field-evidence.test.mjs",
    "test:matchmaking": "node --import tsx --test src/matchmakingParty.test.ts src/matchmakingHuntPolicy.test.ts src/apiKeysConfig.test.ts",
    "test:loadout": "node --import tsx --test src/loadoutSlots.test.ts",
    "test:realtime": "node --import tsx --test src/realtime/jid.test.ts src/realtime/stateMachine.test.ts src/realtime/xml.test.ts src/realtime/XMPPAuth.test.ts src/realtime/DirectChatService.test.ts src/realtime/RoomService.test.ts src/realtime/PresenceService.test.ts src/realtime/SessionRegistry.test.ts",
    "test:auth-security": "node --import tsx --test src/security/accountEligibility.test.ts src/security/totp.test.ts src/security/runtimeAuthorization.test.ts src/security/launcherVersion.test.ts src/controllers/adminDiscordAuth.test.ts src/launcherAuthValidation.test.ts src/launcherUpdatesValidation.test.ts src/security/apiKeyHash.test.ts",
    "test:inventory-storage": "node --import tsx --test src/inventoryStoragePolicy.gamedata.test.ts",
    "test:store": "node --import tsx --test src/controllers/storeRegistry.gamedata.test.ts src/controllers/storePlatinumSpend.gamedata.test.ts src/security/logRedaction.test.ts",
    "test:platinum": "node --import tsx --test src/platinumWallet.test.ts src/skuProgression.test.ts src/diagnostics/economyLedgerMonitor.test.ts src/diagnostics/economyLedgerInventory.test.ts",
    "platinum:generate": "tsx scripts/generate_platinum_store.ts && tsx scripts/generate_inventory_storage_policy.ts",
    "generate:progression-config": "node scripts/generate_progression_config.cjs",
    "generate:slayers-path": "node scripts/generate_slayers_path.cjs",
    "generate:ladyluck-store": "node scripts/generate_ladyluck_store.cjs",
    "inventory:storage-policy:generate": "tsx scripts/generate_inventory_storage_policy.ts",
    "reward-cache:generate": "tsx scripts/generate_reward_cache_store.ts && tsx scripts/generate_inventory_storage_policy.ts",
    "ladyluck:enrich": "tsx scripts/enrich_ladyluck_store.ts && tsx scripts/generate_inventory_storage_policy.ts",
    "inventory:storage-migrate": "tsx --env-file=.env scripts/migrate_inventory_storage.ts",
    "banner:instance-migrate": "tsx --env-file=.env scripts/migrate_banner_instance_ids.ts",
    "starter:instance-migrate": "tsx --env-file=.env scripts/migrate_starter_instance_refs.ts",
    "loadout:slots-migrate": "tsx --env-file=.env scripts/migrate_loadout_slot_entitlements.ts",
    "test:banner-instance": "node --import tsx --test src/bannerInstanceMigration.test.ts",
    "test:starter-instance": "node --import tsx --test src/starterInstanceMigration.test.ts",
    "test:escalation": "node --import tsx --test src/escalationProgress.test.ts",
    "test:progression": "node --import tsx --test src/progressionHardening.gamedata.test.ts",
    "test:p2p-admission": "node --import tsx --test src/p2p/security/admissionTickets.test.ts src/p2p/security/steamTransportIdentity.test.ts src/p2p/security/hostCapabilities.test.ts src/p2p/security/p2pRuntimeArtifacts.test.ts",
    "test:p2p-lifecycle": "node --import tsx --test src/p2p/config/p2pHostPolicy.test.ts src/p2p/controllers/p2pHostLifecycle.test.ts",
    "test:realm-hub": "node --import tsx --test src/p2p/realm/realmHubRules.test.ts src/p2p/persistence/realmHubRepository.test.ts src/p2p/security/hubAuthorization.test.ts src/p2p/routes/realmHosting.test.ts src/p2p/controllers/realmHubFlow.test.ts src/p2p/realm/realmsServiceWiring.test.ts src/p2p/security/hostWrites.test.ts src/p2p/security/p2pInventoryTransactions.test.ts src/p2p/security/p2pInventoryAuthorization.test.ts src/p2p/security/hostGrantPolicy.test.ts src/p2p/routes/progressionReforgeHost.gamedata.test.ts src/p2p/controllers/p2pRealmRouting.test.ts src/p2p/controllers/p2pRealmHunts.test.ts src/p2p/routes/realmHostingStatus.test.ts src/controllers/candidateStatus.test.ts src/p2p/security/hostPlatinumSpend.test.ts src/p2p/observability/huntXpMonitor.test.ts",
    "test:realm-hub-mongo": "node --import tsx --test --test-concurrency=1 src/p2p/persistence/mongo/realmHubMongo.integration.test.ts src/p2p/realm/realmHubMongoFlow.integration.test.ts",
    "test:p2p-bridge-interop": "node scripts/p2p/test_bridge_ticket_interop.mjs ../SteamBridge/build/Release/MysticSteamBridge.exe",
    "admin:bootstrap": "tsx --env-file=.env scripts/bootstrap_admin.ts",
    "account:process-deletions": "tsx --env-file=.env scripts/process_account_deletions.ts",
    "logs:purge-uploaded": "tsx --env-file=.env scripts/purge_uploaded_logs.ts",
    "approval:migrate": "tsx --env-file=.env scripts/migrate_launcher_approval.ts",
    "p2p:steam-link": "tsx --env-file=.env scripts/p2p/bind_p2p_steam_account.ts",
    "test:p2p-operator": "node --import tsx --test scripts/p2p/bind_p2p_steam_account.test.ts",
    "test": "node scripts/run-tests.cjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "dotenv": "^17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "jsonwebtoken": "^9.0.3",
    "ltx": "3.1.2",
    "mongodb": "7.5.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "26.0.0",
    "@types/ws": "8.18.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}
