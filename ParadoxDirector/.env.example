PORT=
MY_IP=
PORT_RANGE_BEGIN=
PORT_RANGE_END=
GAMESERVER_BINARY_PATH=
METAGAME_API_KEY=
SECONDS_TO_WAIT_BETWEEN_GAMESERVER_STARTUP=
# Milliseconds to wait for the DLL's post-Listen ready marker before rejecting a child.
GAMESERVER_READY_TIMEOUT_MS=30000

# Trials rotation interval in whole minutes. Production default is one week (10080).
# For a short end-to-end test, set 30 and restart DeployServer plus the persistent hubs.
TRIALS_ROTATION_MINUTES=10080

# --- Resource guardrails for gameserver spawning (controllers/gameservers.ts) ---
# MAX_CONCURRENT_HUNT_SERVERS: hard cap on live hunt (non-persistent) servers. Over-cap matchmaking
#   requests fall back to Ramsgate instead of spawning another ~1 GB UE4 process (prevents the box
#   from OOMing under matchmaking/travel spam). Size to RAM: 8 GB ~= 2, 16 GB ~= 4-5. Default 3.
# NOTE: empty/abandoned hunts are reclaimed by the gameserver DLL self-terminating after a no-connection
#   grace period (accurate — never cuts an active hunt short). There is intentionally NO wall-clock reap.
MAX_CONCURRENT_HUNT_SERVERS=

# Public Hunt Server Reuse (P2 joins P1's public hunt instead of spawning a new server).
#   ENABLE_PUBLIC_HUNT_REUSE: 1 to enable, 0/unset to disable (default). When enabled, a SHARED request
#     for a player hunt id that already has a live, ready, non-full server joins that server. Requires the
#     DLL PlayerHuntId backfill (default ON) so late joiners still get rewards/kill credit. If attribution
#     is ever wrong, set to 0 to instantly revert to spawn-per-player.
#   PUBLIC_HUNT_MAX_PLAYERS: reuse occupancy cap. MUST match the DLL's HUB_MAX_PLAYERS (the ?MaxPlayers the
#     server actually accepts). Default 4 (Dauntless party size); raise both together if you raise the cap.
ENABLE_PUBLIC_HUNT_REUSE=0
PUBLIC_HUNT_MAX_PLAYERS=4

# Signed server-DLL update channel. It runs before Ramsgate/Dojo start.
SERVER_RUNTIME_AUTO_UPDATE=false
SERVER_RUNTIME_UPDATE_REQUIRED=false
SERVER_RUNTIME_MANIFEST_URL=https://paradox.example.com/launcher/v1/runtime/server/stable/windows-x86_64
# Optional; defaults to MysticParadox.dll beside GAMESERVER_BINARY_PATH.
GAMESERVER_RUNTIME_DLL_PATH=
# Development only. Keep false for a public update channel.
SERVER_RUNTIME_ALLOW_HTTP=false
