{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mystic Paradox Launcher",
  "mainBinaryName": "launcher",
  "version": "0.1.16",
  "identifier": "dev.mysticfox.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mystic Paradox Launcher",
        "width": 1120,
        "height": 700,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:3000 https://paradox.mysticfox.dev https://api.mysticfox.dev; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["mysticparadox"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwQURDNTgzMDhCREFFQUQKUldTdHJyMElnOFd0TUJGeVQyTHJQUitKSFo5QW5PU3lrZGVZR0RVOGgzdXdSNmJCcStudnlVQWEK",
      "endpoints": [
        "https://paradox.mysticfox.dev/launcher/v1/updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
